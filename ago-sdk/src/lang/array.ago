package lang;

// array creator will get ArrayInstance insteadof
class Array<T> with Iterable<T>{
    public final length as int;

    override iterator() as Iterator<T>{
        return new ArrayIterator<T>(this)
    }

    override toString() as string{
        var s = '[';
        for(var i=0; i<length; i++){
            s += this[i]
            if(i < length -1) s += ','
        }
        return s + ']';
    }
}

class ArrayIterator<+T> with Iterator<T>{
    i as int
    fun new(field array as Array<T>){}

    override hasNext() as boolean{
        return i < array.length
    }
    override next() as T{
        return array[i++];
    }
}

final class ArrayExt{
    metaclass{
        fun copyTo<T>(this as Array<T>, sourcePos as int, destination as Array<T>, destPos as int, length as int) native "org.siphonlab.ago.lang.Lang.arrayCopy";

        fun map<T, R>(this as Array<T>, mapper as [Function1<R,T>]) as R[] {
            var l = this.length;
            var arr = new R[l];
            for(var i=0; i<l;i++){
                arr[i] = mapper(this[i]);
            }
            return arr;
        }

        fun join<T>(this as Array<T>, separator as string = ',') as string {
            var l = this.length;
            if(l == 0) return '';

            var sb = new StringBuilder()
            for(var i=0; i<l-1;i++){
                sb.append(this[i]|string).append(separator)
            }
            sb.append(this[l-1]);
            return sb.toString();
        }

        fun filter<T>(this as Array<T>, predicate as [Function1<boolean,T>]) as T[] {
            var count = 0;
            for(var i=0; i<this.length; i++){
                if(predicate(this[i])){
                    count++;
                }
            }
            var arr = new T[count];
            var j = 0;
            for(var i=0; i<this.length; i++){
                if(predicate(this[i])){
                    arr[j++] = this[i];
                }
            }
            return arr;
        }

        fun reduce<T, R>(this as Array<T>, accumulator as [Function2<R,R,T>], initial as R) as R {
            var result = initial;
            for(var i=0; i<this.length; i++){
                result = accumulator(result, this[i]);
            }
            return result;
        }

        fun castTo<T, R>(this as Array<T>) as R[] {
            var l = this.length;
            var arr = new R[l];
            for(var i=0; i<l; i++){
                arr[i] = this[i]|R;
            }
            return arr;
        }

        fun get(this as Array<_>, i as int) as any{
            if(this instanceof Array<int> iarr){
                return iarr[i];
            } else if(this instanceof Array<long> larr){
                return larr[i];
            } else if(this instanceof Array<double> darr){
                return darr[i];
            } else if(this instanceof Array<float> farr){
                return farr[i];
            } else if(this instanceof Array<boolean> barr){
                return barr[i];
            } else if(this instanceof Array<byte> byarr){
                return byarr[i];
            } else if(this instanceof Array<string> sstrarr){
                return sstrarr[i];
            } else if(this instanceof Array<Object> aobj){
                return aobj[i];
            } else {
                return this[i];
            }
        }

        fun set(this as Array<_>, i as int, value as any){
            if(this instanceof Array<int> iarr){
                iarr[i] = value|int;
            } else if(this instanceof Array<long> larr){
                larr[i] = value|long;
            } else if(this instanceof Array<double> darr){
                darr[i] = value|double;
            } else if(this instanceof Array<float> farr){
                farr[i] = value|float;
            } else if(this instanceof Array<boolean> barr){
                barr[i] = value|boolean;
            } else if(this instanceof Array<byte> byarr){
                byarr[i] = value|byte;;
            } else if(this instanceof Array<string> sstrarr){
                sstrarr[i] = value|string;
            } else if(this instanceof Array<Object> aobj){
                aobj[i] = value|Object;
            } else {
                this[i] = value;
            }
        }
    }
}