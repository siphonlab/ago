package lang;

public class Double from Number<double>{
    metaclass{
        fun MIN_VALUE() as double
            native "org.siphonlab.ago.lang.Lang.Double_MIN_VALUE";

        fun MAX_VALUE() as double
            native "org.siphonlab.ago.lang.Lang.Double_MAX_VALUE";

        fun NaN() as double
            native "org.siphonlab.ago.lang.Lang.Double_NaN";

        fun POSITIVE_INFINITY() as double
            native "org.siphonlab.ago.lang.Lang.Double_POSITIVE_INFINITY";

        fun NEGATIVE_INFINITY() as double
            native "org.siphonlab.ago.lang.Lang.Double_NEGATIVE_INFINITY";
    }

    public override intValue() as int    { return value|int; }
    public override longValue() as long  { return value|long; }
    public override floatValue() as float    { return value|float; }
    public override doubleValue() as double  { return value; }
    public override byteValue() as byte      { return value|byte; }
    public override shortValue() as short    { return value|short; }

    public override toString() as string native "org.siphonlab.ago.lang.Lang.Double_toString"

    // --- Instance methods ---

    public fun abs() as double
        native "org.siphonlab.ago.lang.Lang.Double_abs";

    public fun isFinite() as boolean
        native "org.siphonlab.ago.lang.Lang.Double_isFinite";

    public fun isInfinite() as boolean
        native "org.siphonlab.ago.lang.Lang.Double_isInfinite";

    public fun isNaN() as boolean
        native "org.siphonlab.ago.lang.Lang.Double_isNaN";

    public fun roundToInt() as int
        native "org.siphonlab.ago.lang.Lang.Double_roundToInt";

    public fun roundToLong() as long
        native "org.siphonlab.ago.lang.Lang.Double_roundToLong";

    public fun ceil() as double
        native "org.siphonlab.ago.lang.Lang.Double_ceil";

    public fun floor() as double
        native "org.siphonlab.ago.lang.Lang.Double_floor";

    public fun round(decimals as int) as double
        native "org.siphonlab.ago.lang.Lang.Double_round_decimals";
}

// --- Extension methods on primitive double type (direct natives, no boxing) ---

final class DoubleExt{
    metaclass{
        fun abs(this as double) as double
            native "org.siphonlab.ago.lang.Lang.Double_abs_ext";

        fun isFinite(this as double) as boolean
            native "org.siphonlab.ago.lang.Lang.Double_isFinite_ext";

        fun isInfinite(this as double) as boolean
            native "org.siphonlab.ago.lang.Lang.Double_isInfinite_ext";

        fun isNaN(this as double) as boolean
            native "org.siphonlab.ago.lang.Lang.Double_isNaN_ext";

        fun roundToInt(this as double) as int
            native "org.siphonlab.ago.lang.Lang.Double_roundToInt_ext";

        fun roundToLong(this as double) as long
            native "org.siphonlab.ago.lang.Lang.Double_roundToLong_ext";

        fun ceil(this as double) as double
            native "org.siphonlab.ago.lang.Lang.Double_ceil_ext";

        fun floor(this as double) as double
            native "org.siphonlab.ago.lang.Lang.Double_floor_ext";

        fun round(this as double, decimals as int) as double
            native "org.siphonlab.ago.lang.Lang.Double_round_decimals_ext";
    }
}
