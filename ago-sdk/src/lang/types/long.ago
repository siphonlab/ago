package lang;

public class Long from Number<long>{
    metaclass{
        fun toHexString(v as long) as string
            native "org.siphonlab.ago.lang.Lang.Long_toHexString";

        fun MIN_VALUE() as long
            native "org.siphonlab.ago.lang.Lang.Long_MIN_VALUE";

        fun MAX_VALUE() as long
            native "org.siphonlab.ago.lang.Lang.Long_MAX_VALUE";
    }

    public override intValue() as int    { return value|int; }
    public override longValue() as long  { return value; }
    public override floatValue() as float    { return value|float; }
    public override doubleValue() as double  { return value; }
    public override byteValue() as byte      { return value|byte; }
    public override shortValue() as short    { return value|short; }

    public override toString() as string native "org.siphonlab.ago.lang.Lang.Long_toString"

    override hashCode() as int{
        return (value bxor (value >>> 32)) | int;
    }

    // --- Instance methods ---

    public fun abs() as long
        native "org.siphonlab.ago.lang.Lang.Long_abs";

    public fun negate() as long
        native "org.siphonlab.ago.lang.Lang.Long_negate";

    public fun clamp(minVal as long, maxVal as long) as long
        native "org.siphonlab.ago.lang.Lang.Long_clamp";

    public fun hexString() as string
        native "org.siphonlab.ago.lang.Lang.Long_hexString";

    public fun toBinaryString() as string
        native "org.siphonlab.ago.lang.Lang.Long_toBinaryString";

    public fun bitCount() as int
        native "org.siphonlab.ago.lang.Lang.Long_bitCount";

    public fun reverseBytes() as long
        native "org.siphonlab.ago.lang.Lang.Long_reverseBytes";
}

// --- Extension methods on primitive long type (direct natives, no boxing) ---

final class LongExt{
    metaclass{
        fun abs(this as long) as long
            native "org.siphonlab.ago.lang.Lang.Long_abs_ext";

        fun negate(this as long) as long
            native "org.siphonlab.ago.lang.Lang.Long_negate_ext";

        fun clamp(this as long, minVal as long, maxVal as long) as long
            native "org.siphonlab.ago.lang.Lang.Long_clamp_ext";

        fun hexString(this as long) as string
            native "org.siphonlab.ago.lang.Lang.Long_hexString_ext";

        fun toBinaryString(this as long) as string
            native "org.siphonlab.ago.lang.Lang.Long_toBinaryString_ext";

        fun bitCount(this as long) as int
            native "org.siphonlab.ago.lang.Lang.Long_bitCount_ext";

        fun reverseBytes(this as long) as long
            native "org.siphonlab.ago.lang.Lang.Long_reverseBytes_ext";

        fun hashCode(this as long) as int{
            return (this bxor (this >>> 32)) | int;
        }
    }
}
