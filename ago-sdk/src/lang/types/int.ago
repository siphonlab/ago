package lang;

public class Integer from Number<int>{
    metaclass{
        fun toHexString(v as int) as string
            native "org.siphonlab.ago.lang.Lang.Integer_toHexString";

        fun MIN_VALUE() as int
            native "org.siphonlab.ago.lang.Lang.Integer_MIN_VALUE";

        fun MAX_VALUE() as int
            native "org.siphonlab.ago.lang.Lang.Integer_MAX_VALUE";
    }

    public override intValue() as int    { return value; }
    public override longValue() as long  { return value; }
    public override floatValue() as float    { return value; }
    public override doubleValue() as double  { return value; }
    public override byteValue() as byte      { return value|byte; }
    public override shortValue() as short    { return value|short; }

    public override toString() as string native "org.siphonlab.ago.lang.Lang.Integer_toString"

    override hashCode() as int{
        return this.value;
    }

    // --- Instance methods ---

    public fun abs() as int
        native "org.siphonlab.ago.lang.Lang.Integer_abs";

    public fun negate() as int
        native "org.siphonlab.ago.lang.Lang.Integer_negate";

    public fun clamp(minVal as int, maxVal as int) as int
        native "org.siphonlab.ago.lang.Lang.Integer_clamp";

    public fun hexString() as string
        native "org.siphonlab.ago.lang.Lang.Integer_hexString";

    public fun toBinaryString() as string
        native "org.siphonlab.ago.lang.Lang.Integer_toBinaryString";

    public fun bitCount() as int
        native "org.siphonlab.ago.lang.Lang.Integer_bitCount";

    public fun reverseBytes() as int
        native "org.siphonlab.ago.lang.Lang.Integer_reverseBytes";
}

// --- Extension methods on primitive int type (direct natives, no boxing) ---

final class IntExt{
    metaclass{
        fun abs(this as int) as int
            native "org.siphonlab.ago.lang.Lang.Integer_abs_ext";

        fun negate(this as int) as int
            native "org.siphonlab.ago.lang.Lang.Integer_negate_ext";

        fun clamp(this as int, minVal as int, maxVal as int) as int
            native "org.siphonlab.ago.lang.Lang.Integer_clamp_ext";

        fun hexString(this as int) as string
            native "org.siphonlab.ago.lang.Lang.Integer_hexString_ext";

        fun toBinaryString(this as int) as string
            native "org.siphonlab.ago.lang.Lang.Integer_toBinaryString_ext";

        fun bitCount(this as int) as int
            native "org.siphonlab.ago.lang.Lang.Integer_bitCount_ext";

        fun reverseBytes(this as int) as int
            native "org.siphonlab.ago.lang.Lang.Integer_reverseBytes_ext";

        fun hashCode(this as int) as int{
            return this;
        }
    }
}
