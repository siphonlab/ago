package lang;

public class Byte from Number<byte>{
    metaclass{
        fun MIN_VALUE() as byte
            native "org.siphonlab.ago.lang.Lang.Byte_MIN_VALUE";

        fun MAX_VALUE() as byte
            native "org.siphonlab.ago.lang.Lang.Byte_MAX_VALUE";
    }

    public override intValue() as int    { return value|int; }
    public override longValue() as long  { return value|long; }
    public override floatValue() as float    { return value|float; }
    public override doubleValue() as double  { return value; }
    public override byteValue() as byte      { return value; }
    public override shortValue() as short    { return value|short; }

    public override toString() as string native "org.siphonlab.ago.lang.Lang.Byte_toString"

    override hashCode() as int{
        return value | int;
    }

    // --- Instance methods ---

    public fun abs() as byte
        native "org.siphonlab.ago.lang.Lang.Byte_abs";

    public fun clamp(minVal as byte, maxVal as byte) as byte
        native "org.siphonlab.ago.lang.Lang.Byte_clamp";

    public fun toHexString() as string
        native "org.siphonlab.ago.lang.Lang.Byte_toHexString";
}

// --- Extension methods on primitive byte type (direct natives, no boxing) ---

final class ByteExt{
    metaclass{
        fun abs(this as byte) as byte
            native "org.siphonlab.ago.lang.Lang.Byte_abs_ext";

        fun clamp(this as byte, minVal as byte, maxVal as byte) as byte
            native "org.siphonlab.ago.lang.Lang.Byte_clamp_ext";

        fun toHexString(this as byte) as string
            native "org.siphonlab.ago.lang.Lang.Byte_toHexString_ext";

        fun hashCode(this as byte) as int{
            return this | int;
        }
    }
}
