package lang;

public class Short from Number<short>{
    metaclass{
        fun MIN_VALUE() as short
            native "org.siphonlab.ago.lang.Lang.Short_MIN_VALUE";

        fun MAX_VALUE() as short
            native "org.siphonlab.ago.lang.Lang.Short_MAX_VALUE";
    }

    public override intValue() as int    { return value|int; }
    public override longValue() as long  { return value|long; }
    public override floatValue() as float    { return value|float; }
    public override doubleValue() as double  { return value; }
    public override byteValue() as byte      { return value|byte; }
    public override shortValue() as short    { return value; }

    public override toString() as string native "org.siphonlab.ago.lang.Lang.Short_toString"

    // --- Instance methods ---

    public fun abs() as short
        native "org.siphonlab.ago.lang.Lang.Short_abs";

    public fun clamp(minVal as short, maxVal as short) as short
        native "org.siphonlab.ago.lang.Lang.Short_clamp";

    public fun toHexString() as string
        native "org.siphonlab.ago.lang.Lang.Short_toHexString";
}

// --- Extension methods on primitive short type ---

final class ShortExt{
    metaclass{
        fun abs(this as short) as short{
            return new Short(this).abs();
        }

        fun clamp(this as short, minVal as short, maxVal as short) as short{
            return new Short(this).clamp(minVal, maxVal);
        }

        fun toHexString(this as short) as string{
            return new Short(this).toHexString();
        }
    }
}
