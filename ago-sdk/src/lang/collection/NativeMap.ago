package lang;

native class NativeMap<Key, Value> from Map<Key, Value>{

    fun new(){
        throw new IllegalStateException("NativeMap has no constructor, use runtime to create instance");
    }

    override size#get() as int native "org.siphonlab.ago.lang.NativeMap.getSize";
    override isReadOnly() as boolean native "org.siphonlab.ago.lang.NativeMap.isReadOnly";
    override clear() native "org.siphonlab.ago.lang.NativeMap.clear";

    override get#key(index as Key) as Value native "org.siphonlab.ago.lang.NativeMap.get";

    override put(index as Key, value as Value) native "org.siphonlab.ago.lang.NativeMap.put";

    override keys#get() as ReadOnlyCollection<Key>{
        var ls = new NativeArrayList<Key>();
        this.nativeKeys(ls);
        return ls;
    }
    private fun nativeKeys(ls as NativeArrayList<Key>) native "org.siphonlab.ago.lang.NativeMap.keys";

    override values#get() as ReadOnlyCollection<Value> {
        var ls = new NativeArrayList<Value>();
        this.nativeValues(ls);
        return ls;
    }
    private fun nativeValues(ls as NativeArrayList<Value>) native "org.siphonlab.ago.lang.NativeMap.values";

    override containsKey(key as Key) as boolean native "org.siphonlab.ago.lang.NativeMap.containsKey";
    override remove(key as Key) as boolean native "org.siphonlab.ago.lang.NativeMap.removeByKey";

    native class MapIterator with Iterator<KeyValuePair<Key, Value>> {
        fun new() native "org.siphonlab.ago.lang.NativeMap.Iterator_create";
        override hasNext() as boolean native "org.siphonlab.ago.lang.NativeMap.Iterator_hasNext";
        override next() as KeyValuePair<Key, Value> native "org.siphonlab.ago.lang.NativeMap.Iterator_next";
    }

    override iterator() as Iterator<KeyValuePair<Key, Value>>{
        return new MapIterator();
    }

    override putAll(map as ReadOnlyMap<Key,Value>) native "org.siphonlab.ago.lang.NativeMap.putAll"
}
