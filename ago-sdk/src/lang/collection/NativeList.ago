package lang;

native class NativeList<E> from List<E>{

    fun new(){
        throw new IllegalStateException("NativeList has no constructor, use runtime to create instance");
    }

    fun new#array(array as E[]){
        throw new IllegalStateException("NativeList has no constructor, use runtime to create instance");
    }

    override size#get() as int native "org.siphonlab.ago.lang.NativeList.getSize";
    override isReadOnly() as boolean native "org.siphonlab.ago.lang.NativeList.isReadOnly";
    override add(item as E) native "org.siphonlab.ago.lang.NativeList.add";
    override clear() native "org.siphonlab.ago.lang.NativeList.clear";
    override contains(item as E) as boolean native "org.siphonlab.ago.lang.NativeList.contains";
    override remove(item as E) as boolean native "org.siphonlab.ago.lang.NativeList.remove";

    override get#index(index as int) as E native "org.siphonlab.ago.lang.NativeList.getAtIndex";
    override set#index(index as int, value as E) native "org.siphonlab.ago.lang.NativeList.setAtIndex";

    native class ListIterator with Iterator<E> {
        fun new() {create()}
        private fun create() native "org.siphonlab.ago.lang.NativeList.Iterator_create";
        override hasNext() as boolean native "org.siphonlab.ago.lang.NativeList.Iterator_hasNext";
        override next() as E native "org.siphonlab.ago.lang.NativeList.Iterator_next";
    }

    override iterator() as ListIterator{
        return new ListIterator();
    }

    override addAll#array(array as E[]){
        for(var el in array){
            this.add(el);
        }
    }

    override addAll#collection(it as Collection<E>){
        for(var el in it){
            this.add(el);
        }
    }

    override toArray() as E[]{
        var arr = new E[this.size];
        var i = 0;
        for(var el in this){
            arr[i++] = el;
        }
        return arr;
    }
}
