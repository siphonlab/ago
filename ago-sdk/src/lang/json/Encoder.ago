package json;

// =============================================================================
// JsonSerializable — marker interface for types that can encode/decode JSON
// Implementing classes should provide:
//   fun encode(encoder as Encoder);
//   metaclass { fun json_decoder(decoder as Decoder) as <ClassName>; }
// =============================================================================
interface JsonSerializable{
    fun encode(encoder as Encoder);
    //fun new#json_decoder(decoder as Decoder);
}

// =============================================================================
// JsonException — runtime exception for JSON errors
// =============================================================================
class JsonException from RuntimeException{
    fun new#message(message as string){
        super(message);
    }
}

// =============================================================================
// Encoder — writes JSON text using a StringBuilder
// =============================================================================
class Encoder{
    sb as StringBuilder;
    pretty as boolean = false;
    atValue as boolean = false;
    depth as int = 0;

    fun new(){
        this.sb = new StringBuilder();
    }

    override toString() as string{
        return sb.toString();
    }

    fun setPretty(pretty as boolean){
        this.pretty = pretty;
    }

    // Write a raw JSON value (adds comma separator if needed).
    fun writeRaw(s as string){
        if(atValue){
            sb.append(",");
        }
        atValue = true;
        sb.append(s);
    }

    // Encode an int value.
    fun encode#int(value as int){
        writeRaw(value|string);
    }

    // Encode a long value.
    fun encode#long(value as long){
        writeRaw(value|string);
    }

    // Encode a boolean value.
    fun encode#boolean(value as boolean){
        writeRaw(value|string);
    }

    // Encode a float value.
    fun encode#float(value as float){
        writeRaw(value|string);
    }

    // Encode a double value.
    fun encode#double(value as double){
        writeRaw(value|string);
    }

    // Encode a decimal value.
    fun encode#decimal(value as decimal){
        writeRaw(value|string);
    }


    // Encode a char value (as JSON string).
    fun encode#char(value as char){
        writeRaw("\"" + value|string + "\"");
    }

    // Encode a byte value.
    fun encode#byte(value as byte){
        writeRaw(value|string);
    }

    // Encode a short value.
    fun encode#short(value as short){
        writeRaw(value|string);
    }

    // Encode a string value (null-safe).
    fun encode#string(value as string?){
        if(value == null){
            writeRaw("null");
        } else {
            writeRaw("\"" + value.escapeJson() + "\"");
        }
    }

    // Begin encoding an array.
    fun beginArray(){
        if(atValue){
            sb.append(",");
        }
        depth++;
        atValue = false;
        sb.append("[");
    }

    // Finish encoding an array.
    fun endArray(){
        depth--;
        if(depth == 0){
            atValue = false;
        }
        sb.append("]");
    }

    // Begin encoding an object.
    fun beginObject(){
        if(atValue){
            sb.append(",");
        }
        depth++;
        atValue = false;
        sb.append("{");
    }

    // Finish encoding an object.
    fun endObject(){
        depth--;
        if(depth == 0){
            atValue = false;
        }
        sb.append("}");
    }

    // Write an object key.
    fun writeKey(key as string){
        if(atValue){
            sb.append(",");
        }
        atValue = false;
        sb.append("\"");
        sb.append(key.escapeJson());
        sb.append("\":");
    }

    fun encode#object(value as Object){
        if(value instanceof Array<_> arr){
            encode#array(arr);
        } else if(value instanceof List<_> list){
            encode#list(list);
        } else if(value instanceof JsonSerializable ser){
            ser.encode(this);
        } else if(value instanceof Boxer<_> boxer){
            if(value instanceof Boxer<int> bi){
                encode(bi.value);
            } else if(value instanceof Boxer<long> bl){
                encode(bl.value);
            } else if(value instanceof Boxer<float> bf){
                encode(bf.value);
            } else if(value instanceof Boxer<double> bd){
                encode(bd.value);
            } else if(value instanceof Boxer<decimal> bdec){
                encode(bdec.value);
            } else if(value instanceof Boxer<byte> bb){
                encode(bb.value);
            } else if(value instanceof Boxer<short> bs){
                encode(bs.value);
            } else if(value instanceof Boxer<char> bc){
                encode(bc.value);
            } else if(value instanceof Boxer<boolean> bbool){
                encode(bbool.value);
            } else if(value instanceof Boxer<string> bstr){
                encode(bstr.value);
            } else if(value instanceof Boxer<classref> bclassref){
                encode(bclassref.toString());       // Raw mode should encode the scope
            }
        } else {
            beginObject();
            var props = value.class.getProperties(false);
            var l = props.length;
            for(var i=0; i < l; i++){
                var p = props[i];
                var name = p.name;
                writeKey(name);
                encode(value[name]);
            }
            endObject();
        }
    }

    fun encode#array(value as Array<_>){
        var l = value.length;
        if(value instanceof Array<int> iarr){
            beginArray();
            for(var i=0; i<l; i++){
                encode(iarr[i]);
            }
            endArray();
        } else if(value instanceof Array<long> larr){
            beginArray();
            for(var i=0; i<l; i++){
                encode(larr[i]);
            }
            endArray();
        } else if(value instanceof Array<double> darr){
            beginArray();
            for(var i=0; i<l; i++){
                encode(darr[i]);
            }
            endArray();
        } else if(value instanceof Array<float> farr){
            beginArray();
            for(var i=0; i<l; i++){
                encode(farr[i]);
            }
            endArray();
        } else if(value instanceof Array<boolean> barr){
            beginArray();
            for(var i=0; i<l; i++){
                encode(barr[i]);
            }
            endArray();
        } else if(value instanceof Array<byte> byarr){
            beginArray();
            for(var i=0; i<l; i++){
                encode(byarr[i]);
            }
            endArray();
        } else if(value instanceof Array<short> sharr){
            beginArray();
            for(var i=0; i<l; i++){
                encode(sharr[i]);
            }
            endArray();
        } else if(value instanceof Array<char> carr){
            beginArray();
            for(var i=0; i<l; i++){
                encode(carr[i]);
            }
            endArray();
        } else if(value instanceof Array<decimal> decarr){
            beginArray();
            for(var i=0; i<l; i++){
                encode(decarr[i]);
            }
            endArray();
        } else if(value instanceof Array<classref> crarr){
            beginArray();
            for(var i=0; i<l; i++){
                encode((crarr[i]|ClassRef).toString());
            }
            endArray();
        } else if(value instanceof Array<string> sstrarr){
            beginArray();
            for(var i=0; i<l; i++){
                encode(sstrarr[i]);
            }
            endArray();
        } else if(value.isObjectArray()){
            beginArray();
            for(var i=0; i< l; i++){
                encode#object(value.getObjectElement(i));
            }
            endArray();
        } else {
            beginArray();
            for(var i=0; i< l; i++){
                encode(value[i]);
            }
            endArray();
        }
    }

    fun encode#list(value as List<_>){
        beginArray();
        var l = value.size;
        for(var i = 0; i < l; i++){
            encode#object(value[i]);
        }
        endArray();
    }

    fun encode#any(v as any){
        if(v == null){
            writeRaw('null');
        } else if(v instanceof string str){
            encode(str);
        } else if(v instanceof Object obj){
            encode(obj);
        } else if(v instanceof boolean B){
            encode(B);
        } else if(v instanceof int i){
            encode(i);
        } else if(v instanceof double d){
            encode(d);
        } else if(v instanceof long l){
            encode(l);
        } else if(v instanceof decimal dec){
            encode(dec);
        } else if(v instanceof float f){
            encode(f);
        } else if(v instanceof char c){
            encode(c);
        } else if(v instanceof byte b){
            encode(b);
        } else if(v instanceof short s){
            encode(s);
        } else if(v instanceof classref cr){
            encode((cr|ClassRef).toString())
        } else {
            Trace.print($"unknown v = ${v}"$);
        }
    }

}
