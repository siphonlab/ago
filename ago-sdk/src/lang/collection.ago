package lang;

interface Collection<T> from Iterable<T>{
    fun size#get() as int;
    fun isReadOnly() as boolean;
    fun add(item as T);
    fun clear();
    fun contains(item as T) as boolean;
    fun remove(item as T) as boolean;

    fun copyTo#offset(arr as T[], arrayOffset as int);
    fun copyTo#arr(arr as T[]);
    fun copyTo#offset_length(arr as T[], arrayOffset as int, length as int);
    fun toArray() as T[];
}

interface ReadOnlyCollection<+T> from Iterable<T>{
    fun size#get() as int;
    fun isReadOnly() as boolean;
    fun add(item as T);
    fun clear();
    fun contains(item as T) as boolean;
    fun copyTo#offset(arr as T[], arrayOffset as int);
    fun copyTo#arr(arr as T[]);
    fun copyTo#offset_length(arr as T[], arrayOffset as int, length as int);
    fun remove(item as T) as boolean;
}

interface ReadWriteList<T> from Collection<T>, Iterable<T>{
    fun get#index(index as int) as T;
    fun set#index(index as int, value as T);
}

interface ReadOnlyList<+T> from ReadOnlyCollection<T>{
    fun get#index(index as int) as T;
}

abstract class List<T> with ReadWriteList<T>, ReadOnlyList<T>{

    abstract fun new();

    abstract fun new#array(array as T[]);

    abstract fun addAll#array(array as T[]);

    fun addAll#iterable(it as Iterable<T>){
        for(var el in it){
            this.add(el);
        }
    }

    fun addAll#iterator(it as Iterator<T>){
        for(var el in it){
            this.add(el);
        }
    }

    fun addAll#generator(it as Generator<T>){
        for(var el in it){
            this.add(el);
        }
    }

    abstract fun addAll#collection(it as Collection<T>);

    override toString() as string{
        var s = '[' + this.getClass().getName() + '|';
        var cnt = this.size;
        for(var el in this){
            s += el;
            cnt --;
            if(cnt > 0) s += ','
        }
        return s + ']';
    }

    override toArray() as T[]{
        var arr = new T[this.size];
        var i = 0;
        for(var el in this){
            arr[i++] = el;
        }
        return arr;
    }

    override copyTo#offset(arr as T[], arrayOffset as int){
        copyTo(arr, arrayOffset, arr.length - arrayOffset);
    }

    override copyTo#arr(arr as T[]){
        copyTo(arr, 0, arr.length);
    }

    override copyTo#offset_length(arr as T[], arrayOffset as int, length as int) {
        var i = arrayOffset;
        var outputted = 0;
        var arrLength = arr.length;
        for(var el in this){
            arr[i++] = el;
            if(i == arrLength) break;
            outputted++
            if(outputted == length) break;
        }
    }
}

// ------------------- map ------------------------------
class KeyValuePair<Key, Value>{
    key as Key {public get;}
    value as Value {public get;}

    fun new(key as Key, value as Value){
        this.key = key;
        this.value = value;
    }

    override toString() as string{
        return key + "=" + value;
    }
}

interface ReadWriteMap<Key,Value> from Iterable<KeyValuePair<Key, Value>>{
    fun get#key(index as Key) as Value;
    fun put(index as Key, value as Value);
    fun keys#get() as ReadOnlyCollection<Key>;
    fun values#get() as ReadOnlyCollection<Value>;
    fun containsKey(key as Key) as boolean;
    fun remove(key as Key) as boolean;
    fun putAll(map as ReadOnlyMap<Key,Value>);

    fun size#get() as int;
    fun isReadOnly() as boolean;
    fun clear();
}

interface ReadOnlyMap<Key,Value> from Iterable<KeyValuePair<Key, Value>>{
    fun get#key(index as Key) as Value;
    fun keys#get() as ReadOnlyCollection<Key>;
    fun values#get() as ReadOnlyCollection<Value>;
    fun containsKey(key as Key) as boolean;

    fun size#get() as int;
    fun isReadOnly() as boolean;
    fun clear();
}

abstract class Map<Key, Value> with ReadWriteMap<Key, Value>, ReadOnlyMap<Key, Value>{

    override toString() as string{
        var s = '{' + this.getClass().getName() + '|';
        var cnt = this.size;
        for(var el in this){
            s += el;
            cnt --;
            if(cnt > 0) s += ','
        }
        return s + '}';
    }
}

class KeyNotFoundException from RuntimeException{
    fun new#message(message as string){
        super(message);
    }
}

final class MapExt{
    metaclass{
        fun getKeyType(this as Map<_,_>) as ClassRef native "org.siphonlab.ago.lang.Reflect.Map_getKeyType";

        fun getValueType(this as Map<_,_>) as ClassRef native "org.siphonlab.ago.lang.Reflect.Map_getValueType";

        fun keyIsString(this as Map<_,_>) as boolean native "org.siphonlab.ago.lang.Reflect.Map_keyIsString";
    }
}


