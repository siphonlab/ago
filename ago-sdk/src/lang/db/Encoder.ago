package json;

// =============================================================================
// DbEncoder — JSON encoder for full dump of ago objects with DbSlots
// Inherits from json.Encoder, overrides encode#object to handle DB entities.
// Entry point: encode#object(obj)
// =============================================================================
class SlotsEncoder from Encoder{

    // Override encode#object to handle DbSlots-based objects specially.
    override fun encode#object(value as Object){
        if(isDbObject(value)){
            beginObject();

            // rowState
            writeKey("rowState");
            var rs = getRowStateString(value);
            if(rs != "Saving"){
                encode#string(rs);
            } else {
                encode#string("Unchanged");
            }

            // usingInstances
            writeKey("usingInstances");
            beginArray();
            var instances = getUsingInstances(value);
            for(var inst in instances){
                encodeObjectRef(inst);
            }
            endArray();

            // slots
            writeKey("slots");
            if(value instanceof Array<_> arr){
                encodeArrayDump(arr);
            } else if(value instanceof List<_> list){
                encodeListDump(list);
            } else if(value instanceof Map<_,_> map){
                encodeMapDump(map);
            } else {
                encodeSlotsArray(value);
            }

            endObject();
        } else {
            super.encode#object(value);
        }
    }

    // Encode object reference as a JSON string: "ClassName:id"
    fun encodeObjectRef(obj as Object){
        var ref = getObjectRefString(obj);
        writeRaw("\"" + ref.escapeJson() + "\"");
    }

    // Check if an object has DbSlots internally.
    fun isDbObject(obj as Object) as boolean native "org.siphonlab.ago.runtime.db.sdk.DbJsonEncoder.isDbObject";

    // Get row state name string from DbSlots.
    fun getRowStateString(obj as Object) as string native "org.siphonlab.ago.runtime.db.sdk.DbJsonEncoder.getRowStateString";

    // Get using instances array from DbSlots.
    fun getUsingInstances(obj as Object) as Object[] native "org.siphonlab.ago.runtime.db.sdk.DbJsonEncoder.getUsingInstances";

    // Get slot value at given index (returns typed value based on caller's expected type).
    fun getSlotValue<T>(obj as Object, index as int) as T native "org.siphonlab.ago.runtime.db.sdk.DbJsonEncoder.getSlotValue";

    // Check if a union (nullable) slot at the given index is null.
    fun isSlotNull(obj as Object, index as int) as boolean native "org.siphonlab.ago.runtime.db.sdk.DbJsonEncoder.isSlotNull";

    // Get union slot value at given index for nullable/union slots.
    fun getSlotUnionValue<T>(obj as Object, index as int) as T native "org.siphonlab.ago.runtime.db.sdk.DbJsonEncoder.getSlotUnionValue";

    // Get object reference string for an instance: "ClassName:id".
    fun getObjectRefString(obj as Object) as string native "org.siphonlab.ago.runtime.db.sdk.DbJsonEncoder.getObjectRefString";

    // Check if a ClassRef represents a Boxer type.
    fun isBoxerType(type as ClassRef) as boolean native "org.siphonlab.ago.runtime.db.sdk.DbJsonEncoder.isBoxerType";

    // Get the base class for a nullable type, or null if not nullable.
    fun getNullableBaseClass(type as ClassRef) as ClassRef? native "org.siphonlab.ago.runtime.db.sdk.DbJsonEncoder.getNullableBaseClass";

    // Encode all slots of an object as a JSON array.
    fun encodeSlotsArray(obj as Object){
        beginArray();
        var slotDefs = obj.class.getSlots();
        for(var i = 0; i < slotDefs.length; i++){
            var slotDef = slotDefs[i];
            var slotType = slotDef.type;
            var index = slotDef.index;
            switch(slotType.typeCode){
            case TypeCode.INT:       encode#int(getSlotValue<int>(obj, index)); break;
            case TypeCode.LONG:      encode#long(getSlotValue<long>(obj, index)); break;
            case TypeCode.FLOAT:     encode#float(getSlotValue<float>(obj, index)); break;
            case TypeCode.DOUBLE:    encode#double(getSlotValue<double>(obj, index)); break;
            case TypeCode.BOOLEAN:   encode#boolean(getSlotValue<boolean>(obj, index)); break;
            case TypeCode.BYTE:      encode#byte(getSlotValue<byte>(obj, index)); break;
            case TypeCode.SHORT:     encode#short(getSlotValue<short>(obj, index)); break;
            case TypeCode.CHAR:      encode#char(getSlotValue<char>(obj, index)); break;
            case TypeCode.DECIMAL:   encode#decimal(getSlotValue<decimal>(obj, index)); break;
            case TypeCode.STRING:    encode#string(getSlotValue<string>(obj, index)); break;
            case TypeCode.OBJECT:    encodeObjectSlotValue(getSlotValue<Object>(obj, index), slotType); break;
            case TypeCode.CLASS_REF: encode#string((getSlotValue<ClassRef>(obj, index)|ClassRef).toString()); break;
            case TypeCode.UNION:     // now union only nullable
                if(isSlotNull(obj, index)){
                    writeRaw("null");
                } else {
                    var baseType = slotType.nullableBaseClass
                    switch(baseType.typeCode){
                        case TypeCode.INT:       encode#int(getSlotUnionValue<int>(obj, index)); break;
                        case TypeCode.LONG:      encode#long(getSlotUnionValue<long>(obj, index)); break;
                        case TypeCode.FLOAT:     encode#float(getSlotUnionValue<float>(obj, index)); break;
                        case TypeCode.DOUBLE:    encode#double(getSlotUnionValue<double>(obj, index)); break;
                        case TypeCode.BOOLEAN:   encode#boolean(getSlotUnionValue<boolean>(obj, index)); break;
                        case TypeCode.BYTE:      encode#byte(getSlotUnionValue<byte>(obj, index)); break;
                        case TypeCode.SHORT:     encode#short(getSlotUnionValue<short>(obj, index)); break;
                        case TypeCode.CHAR:      encode#char(getSlotUnionValue<char>(obj, index)); break;
                        case TypeCode.DECIMAL:   encode#decimal(getSlotUnionValue<decimal>(obj, index)); break;
                        case TypeCode.STRING:    encode#string(getSlotUnionValue<string>(obj, index)); break;
                        case TypeCode.OBJECT:    encodeObjectSlotValue(getSlotUnionValue<Object>(obj, index), baseType); break;
                    }
                }
                break;
            }
        }
        endArray();
    }

    fun encodeObjectSlotValue(slotValue as Object, slotType as ClassRef){
        // Boxer type check.
        if(slotValue instanceof Boxer<_> boxer){
            // If value's runtime type matches SlotDef type, let parent encoder handle unboxing.
            if(slotValue.class.equals(slotType)){
                super.encode#object(slotValue);       // boxer -> primitive
            } else {
                // Type mismatch: embed as {type: "typename", value: primitive}.
                beginObject();
                writeKey("type");
                encode#string(slotValue.class.getName());
                writeKey("value");
                encode#object(slotValue);
                endObject();
            }
        } else {
            encodeObjectRef(slotValue|Object);
        }
    }

    // Encode Array dump: elements directly, Object refs for instances.
    fun encodeArrayDump(value as Array<_>){
        var l = value.length;
        if(value.isObjectArray()){
            beginArray();
            var elType = value.class.elementTypeOfArray();
            for(var i=0; i< l; i++){
                var elem = value.getObjectElement(i);
                encodeObjectSlotValue(elem, elType);
            }
            endArray();
        } else if(value.isUnionArray()){
            var elType = value.class.elementTypeOfArray();
            var baseType = elType.nullableBaseClass;
            beginArray();
            for(var i=0; i< l; i++){
                encodeNullableValue(value[i], baseType);
            }
            endArray();
        } else {
            encode#array(value);
        }
    }

    fun encodeNullableValue(value as any, baseType as ClassRef){
        if(value == null){
            writeRaw('null');
            return;
        }
        switch(baseType.typeCode){
            case TypeCode.INT:       encode#int(value|int); break;
            case TypeCode.LONG:      encode#long(value|long); break;
            case TypeCode.FLOAT:     encode#float(value|float); break;
            case TypeCode.DOUBLE:    encode#double(value|double); break;
            case TypeCode.BOOLEAN:   encode#boolean(value|boolean); break;
            case TypeCode.BYTE:      encode#byte(value|byte); break;
            case TypeCode.SHORT:     encode#short(value|short); break;
            case TypeCode.CHAR:      encode#char(value|char); break;
            case TypeCode.DECIMAL:   encode#decimal(value|decimal); break;
            case TypeCode.STRING:    encode#string(value|string); break;
            case TypeCode.OBJECT:    encodeObjectSlotValue(value|Object, baseType); break;
        }
    }

    // Encode List dump: elements directly, Object refs for instances.
    fun encodeListDump(value as List<_>){
        beginArray();
        var elType = value.getElementType();
        switch(elType.typeCode){
            case TypeCode.OBJECT:
                for(var obj in value){
                    encodeObjectSlotValue(obj|Object, elType);
                }
                break;
            case TypeCode.UNION:
                var baseType = elType.nullableBaseClass;
                for(var u in value){
                    encodeNullableValue(u, baseType);
                }
                break;
            case TypeCode.INT:
                for(var i in value | List<int>){
                    encode#int(i);
                }
                break;
            case TypeCode.LONG:
                for(var l in value | List<long>){
                    encode#long(l);
                }
                break;
            case TypeCode.FLOAT:
                for(var f in value | List<float>){
                    encode#float(f);
                }
                break;
            case TypeCode.DOUBLE:
                for(var d in value | List<double>){
                    encode#double(d);
                }
                break;
            case TypeCode.BOOLEAN:
                for(var b in value | List<boolean>){
                    encode#boolean(b);
                }
                break;
            case TypeCode.BYTE:
                for(by in value | List<byte>){
                    encode#byte(by);
                }
                break;
            case TypeCode.SHORT:
                for(var s in value | List<short>){
                    encode#short(s);
                }
                break;
            case TypeCode.CHAR:
                for(var c in value | List<char>){
                    encode#char(c);
                }
                break;
            case TypeCode.DECIMAL:
                for(var dec in value | List<decimal>){
                    encode#decimal(dec);
                }
                break;
            case TypeCode.STRING:
                for(var str in value | List<string>){
                    encode#string(str);
                }
                break;
        }
        endArray();
    }

    // Encode Map dump: [[key, value], ...] form.
    fun encodeMapDump(value as Map<_,_>){
        beginArray();
        var keyType = value.getKeyType();
        var valueType = value.getValueType();
        for(var kv in value){
            beginArray();
            encodeMapEntry(kv.key, keyType);
            encodeMapEntry(kv.value, valueType);
            endArray();
        }
        endArray();
    }

    fun encodeMapEntry(entry as any, entryType as ClassRef){
        switch(entryType.typeCode){
            case TypeCode.OBJECT:
                if(entry == null){
                    writeRaw("null");
                } else {
                    encodeObjectSlotValue(entry|Object, entryType);
                }
                break;
            case TypeCode.UNION:
                var baseType = entryType.nullableBaseClass;
                encodeNullableValue(entry, baseType);
                break;
            case TypeCode.INT:       encode#int(entry|int); break;
            case TypeCode.LONG:      encode#long(entry|long); break;
            case TypeCode.FLOAT:     encode#float(entry|float); break;
            case TypeCode.DOUBLE:    encode#double(entry|double); break;
            case TypeCode.BOOLEAN:   encode#boolean(entry|boolean); break;
            case TypeCode.BYTE:      encode#byte(entry|byte); break;
            case TypeCode.SHORT:     encode#short(entry|short); break;
            case TypeCode.CHAR:      encode#char(entry|char); break;
            case TypeCode.DECIMAL:   encode#decimal(entry|decimal); break;
            case TypeCode.STRING:    encode#string(entry|string); break;
        }
    }

