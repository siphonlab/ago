package lang;

public class String from Boxer<string>{

    override hashCode() as int{
        return stringHashCode(value);
    }

    fun stringHashCode(s as string) as int
            native "org.siphonlab.ago.lang.Lang.String_hashCode";

    override equals(obj as Object) as boolean{
        if(this == obj) return true;
        return (obj instanceof String aString) and value == aString.value;
    }

    override toString() as string{
        return value;
    }

    // --- Instance methods (native implementations) ---

    public fun length() as int
        native "org.siphonlab.ago.lang.Lang.String_length";

    public fun charAt(index as int) as char
        native "org.siphonlab.ago.lang.Lang.String_charAt";

    public fun substring(beginIndex as int) as string
        native "org.siphonlab.ago.lang.Lang.String_substring_begin";

    public fun substring#se(beginIndex as int, endIndex as int) as string
        native "org.siphonlab.ago.lang.Lang.String_substring_begin_end";

    public fun concat(str as string) as string{
        return value + str;
    }

    public fun contains(target as string) as boolean
        native "org.siphonlab.ago.lang.Lang.String_contains";

    public fun startsWith(prefix as string) as boolean
        native "org.siphonlab.ago.lang.Lang.String_startsWith";

    public fun endsWith(suffix as string) as boolean
        native "org.siphonlab.ago.lang.Lang.String_endsWith";

    public fun indexOf#ch(ch as char) as int
        native "org.siphonlab.ago.lang.Lang.String_indexOf_char";

    public fun indexOf#str(str as string) as int
        native "org.siphonlab.ago.lang.Lang.String_indexOf_str";

    public fun lastIndexOf#ch(ch as char) as int
        native "org.siphonlab.ago.lang.Lang.String_lastIndexOf_char";

    public fun lastIndexOf#str(str as string) as int
        native "org.siphonlab.ago.lang.Lang.String_lastIndexOf_str";

    public fun trim() as string
        native "org.siphonlab.ago.lang.Lang.String_trim";

    public fun toLowerCase() as string
        native "org.siphonlab.ago.lang.Lang.String_toLowerCase";

    public fun toUpperCase() as string
        native "org.siphonlab.ago.lang.Lang.String_toUpperCase";

    public fun replace#old_new(oldChar as char, newChar as char) as string
        native "org.siphonlab.ago.lang.Lang.String_replace_char";

    public fun replace#old_str(oldStr as string, newStr as string) as string
        native "org.siphonlab.ago.lang.Lang.String_replace_str";

    public fun split(separator as string) as string[]
        native "org.siphonlab.ago.lang.Lang.String_split";

    public fun isEmpty() as boolean{
        return value == "";
    }

    public fun equalsIgnoreCase(other as string) as boolean
        native "org.siphonlab.ago.lang.Lang.String_equalsIgnoreCase";

}

// --- Extension methods on primitive string type (delegate via boxing) ---

final class StringExt{
    metaclass{
        fun length(this as string) as int{
            return new String(this).length();
        }

        fun charAt(this as string, index as int) as char{
            return new String(this).charAt(index);
        }

        fun substring(this as string, beginIndex as int) as string{
            return new String(this).substring(beginIndex);
        }

        fun substring#se(this as string, beginIndex as int, endIndex as int) as string{
            return new String(this).substring(beginIndex, endIndex);
        }

        fun concat(this as string, str as string) as string{
            return this + str;
        }

        fun contains(this as string, target as string) as boolean{
            return new String(this).contains(target);
        }

        fun startsWith(this as string, prefix as string) as boolean{
            return new String(this).startsWith(prefix);
        }

        fun endsWith(this as string, suffix as string) as boolean{
            return new String(this).endsWith(suffix);
        }

        fun indexOf#ch(this as string, ch as char) as int{
            return new String(this).indexOf(ch);
        }

        fun indexOf#str(this as string, str as string) as int{
            return new String(this).indexOf(str);
        }

        fun lastIndexOf#ch(this as string, ch as char) as int{
            return new String(this).lastIndexOf(ch);
        }

        fun lastIndexOf#str(this as string, str as string) as int{
            return new String(this).lastIndexOf(str);
        }

        fun trim(this as string) as string{
            return new String(this).trim();
        }

        fun toLowerCase(this as string) as string{
            return new String(this).toLowerCase();
        }

        fun toUpperCase(this as string) as string{
            return new String(this).toUpperCase();
        }

        fun replace#old_new(this as string, oldChar as char, newChar as char) as string{
            return new String(this).replace(oldChar, newChar);
        }

        fun replace#old_str(this as string, oldStr as string, newStr as string) as string{
            return new String(this).replace(oldStr, newStr);
        }

        fun split(this as string, separator as string) as string[]{
            return new String(this).split(separator);
        }

        fun isEmpty(this as string) as boolean{
            return this == "";
        }

        fun equalsIgnoreCase(this as string, other as string) as boolean{
            return new String(this).equalsIgnoreCase(other);
        }
    }
}
