package io;

// =============================================================================
// FileSystem — entry point for file operations (wraps Vert.x FileSystem)
// =============================================================================
final class FileSystem{
    private fun new(){}

    metaclass{
        fun open(path as string) as File
                native 'org.siphonlab.ago.runtime.vertx.File.FileSystem_open';

        fun readFile(path as string) as Buffer
                native 'org.siphonlab.ago.runtime.vertx.File.FileSystem_readFile';

        fun writeFile(path as string, data as Buffer) as void
                native 'org.siphonlab.ago.runtime.vertx.File.FileSystem_writeFile';

        fun exists(path as string) as boolean
                native 'org.siphonlab.ago.runtime.vertx.File.FileSystem_exists';

        fun size(path as string) as long
                native 'org.siphonlab.ago.runtime.vertx.File.FileSystem_size';

        fun mkdir(path as string) as void
                native 'org.siphonlab.ago.runtime.vertx.File.FileSystem_mkdir';

        fun rename(oldPath as string, newPath as string) as void
                native 'org.siphonlab.ago.runtime.vertx.File.FileSystem_rename';

        fun delete(path as string) as void
                native 'org.siphonlab.ago.runtime.vertx.File.FileSystem_delete';
    }
}

// =============================================================================
// File — wraps Vert.x AsyncFile (implements ReadStream<Buffer> + WriteStream<Buffer>)
// =============================================================================
native class File with ReadStream<Buffer>, WriteStream<Buffer>{
    // -- read -----------------------------------------------------------------
    fun read(buffer as Buffer, offset as int, position as long, length as int) as Buffer
            native 'org.siphonlab.ago.runtime.vertx.File.File_read';

    override generator fun gen() as Buffer native "org.siphonlab.ago.runtime.vertx.IO.ReadStream_generator";
    override fun pause() as File native 'org.siphonlab.ago.runtime.vertx.File.File_pause';
    override fun resume() as File native 'org.siphonlab.ago.runtime.vertx.File.File_resume';
    override fun fetch(amount as long) as File native 'org.siphonlab.ago.runtime.vertx.File.File_fetch';
    override fun byeRead() native "org.siphonlab.ago.runtime.vertx.IO.ReadStream_byeRead";

    // -- write ----------------------------------------------------------------
    fun write#buf_pos(buffer as Buffer, position as long) as void
            native 'org.siphonlab.ago.runtime.vertx.File.File_write';

    override fun write(data as Buffer) native "org.siphonlab.ago.runtime.vertx.IO.WriteStream_write";
    override fun setWriteQueueMaxSize(maxSize as int) native "org.siphonlab.ago.runtime.vertx.IO.WriteStream_setWriteQueueMaxSize";
    override fun writeQueueFull() as boolean native "org.siphonlab.ago.runtime.vertx.IO.WriteStream_writeQueueFull";
    override fun byeWrite() native "org.siphonlab.ago.runtime.vertx.IO.WriteStream_byeWrite";
    override fun watchDrain() as WriteStream<Buffer>.DrainHandler native "org.siphonlab.ago.runtime.vertx.IO.WriteStream_watchDrain";

    // -- position helpers -----------------------------------------------------
    fun setReadPos(pos as long) as void native 'org.siphonlab.ago.runtime.vertx.File.File_setReadPos';
    fun setWritePos(pos as long) as void native 'org.siphonlab.ago.runtime.vertx.File.File_setWritePos';
    fun getWritePos() as long native 'org.siphonlab.ago.runtime.vertx.File.File_getWritePos';

    // -- read-length helpers --------------------------------------------------
    fun setReadLength(length as long) as void native 'org.siphonlab.ago.runtime.vertx.File.File_setReadLength';
    fun getReadLength() as long native 'org.siphonlab.ago.runtime.vertx.File.File_getReadLength';

    // -- misc -----------------------------------------------------------------
    fun size() as long native 'org.siphonlab.ago.runtime.vertx.File.File_size';
    fun flush() as void native 'org.siphonlab.ago.runtime.vertx.File.File_flush';
    fun close() as void native 'org.siphonlab.ago.runtime.vertx.File.File_close';
}
