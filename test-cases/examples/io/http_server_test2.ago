// with route() support
package io_test;

import io.HttpServer;
import io.HttpServerRequest;
import io.HttpResponse;
import io.Route;

fun main(){
    var server = new HttpServer(new HttpServer.Options() with { .logActivity = false; });

    server.route(hello);
    server.route(echo);

    server.listen(8080);
}


fun hello() with Route::("GET", "/hello"){
    ctxt.end("fine")
}

fun echo() with Route::("POST", "/echo"){
    var body = ctxt.body();     // RequestBody
    var s = body.asString();
    Trace.print(s);
    if(s != null)
        ctxt.end(s)
    else
        ctxt.end('<no data>')
}

