import json.SlotsEncoder;
import lang.Entity;

class Address from Entity<Address, long>{
    public city as string;
    public zipCode as int;
}

class Employee from Entity<Employee, long>{
    public name as string;
    public age as int;
    public addr as Address;
}

fun encodeIt(){
    var addr = new Address();
    addr.city = "Beijing";
    addr.zipCode = 100000;

    var emp = new Employee();
    emp.name = "Bob";
    emp.age = 25;
    emp.addr = addr;

    var enc = new SlotsEncoder();
    enc.encode(addr);
    Trace.print(enc.toString());

    var enc2 = new SlotsEncoder();
    enc2.encode(emp);
    Trace.print(enc2.toString());
}

fun main(){
    await encodeIt() via EntitySpace.new#();
}
