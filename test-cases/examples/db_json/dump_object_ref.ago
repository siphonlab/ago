import json.Encoder;
import lang.Entity;

// Define two entity classes with object reference between them
class Address from Entity<Address, long>{
    public city as string;
    public zipCode as int;
}

class Employee from Entity<Employee, long>{
    public name as string;
    public age as int;
    public addr as Address;
}

fun main(){
    var enc = new Encoder();

    // Create address entity
    var addr = new Address();
    addr.city = "Beijing";
    addr.zipCode = 100000;

    // Create employee entity with reference to address
    var emp = new Employee();
    emp.name = "Bob";
    emp.age = 25;
    emp.addr = addr;

    // Dump the employee — addr slot should be an object ref string
    enc.encode(emp|Object);
    Trace.print(enc.toString());
}
