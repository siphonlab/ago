import json.SlotsEncoder;
import lang.Entity;

class Person from Entity<Person, long>{
    public name as string;
    public age as int;
    public active as boolean;
    public score as double;
}

fun encodeIt(){
    var p = new Person();
    p.name = "Alice";
    p.age = 30;
    p.active = true;
    p.score = 2.718;
    var enc = new SlotsEncoder();
    enc.encode(p);
    Trace.print(enc.toString());
}

fun main(){
    await encodeIt() via EntitySpace.new#();
}
