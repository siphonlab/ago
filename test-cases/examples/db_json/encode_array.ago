import json.SlotsEncoder;
import lang.Entity;

class Team from Entity<Team, long>{
    public name as string;
    public scores as int[];
}

fun encodeIt(){
    var team = new Team();
    team.name = "Alpha";
    team.scores = [90, 85, 92];

    var enc = new SlotsEncoder();
    enc.encode(team);
    Trace.print(enc.toString());
}

fun main(){
    await encodeIt() via EntitySpace.new#();
}
