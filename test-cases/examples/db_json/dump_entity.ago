import json.SlotsEncoder;
import lang.Entity;

// Define a simple entity with primitive slots
class Person {
    public name as string;
    public age as int;
    public active as boolean;
}

fun main(){
    // Create encoder instance
    var enc = new SlotsEncoder();

    // Create person entity
    var p = new Person();
    p.name = "Alice";
    p.age = 30;
    p.active = true;

    // Dump the entity using encode#object
    enc.encode(p);
    Trace.print(enc.toString());
}
