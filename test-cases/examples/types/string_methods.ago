fun main(){
    var s = "Hello";
    var boxed = new String(s);

    // length
    Trace.print(boxed.length());
    Trace.print(s.length());

    // charAt
    Trace.print(boxed.charAt(0));
    Trace.print(s.charAt(0));

    // substring
    Trace.print(boxed.substring(1));
    Trace.print(s.substring(1));

    // concat
    Trace.print(boxed.concat("World"));
    Trace.print(s.concat("World"));

    // contains
    var sw = "Hello World";
    Trace.print(new String(sw).contains("World"));
    Trace.print(sw.contains("World"));

    // startsWith
    Trace.print(new String(sw).startsWith("Hello"));
    Trace.print(sw.startsWith("Hello"));

    // endsWith
    Trace.print(new String(sw).endsWith("World"));
    Trace.print(sw.endsWith("World"));

    // indexOf char
    Trace.print(boxed.indexOf('e'));
    Trace.print(s.indexOf('e'));

    // indexOf str
    Trace.print(new String(sw).indexOf("World"));
    Trace.print(sw.indexOf("World"));

    // lastIndexOf char
    Trace.print(boxed.lastIndexOf('o'));
    Trace.print(s.lastIndexOf('o'));

    // trim
    var padded = "   Hello   ";
    Trace.print(new String(padded).trim());
    Trace.print(padded.trim());

    // toLowerCase
    Trace.print(new String(sw).toLowerCase());
    Trace.print(sw.toLowerCase());

    // toUpperCase
    Trace.print(new String(sw).toUpperCase());
    Trace.print(sw.toUpperCase());

    // replace char
    Trace.print(boxed.replace('l', 'i'));
    Trace.print(s.replace('l', 'i'));

    // replace str
    Trace.print(new String(sw).replace("Hello ", "Hi "));
    Trace.print(sw.replace("Hello ", "Hi "));

    // split
    var parts = boxed.split("");
    Trace.print(parts);
    var parts2 = s.split("");
    Trace.print(parts2);

    // isEmpty
    Trace.print(boxed.isEmpty());
    Trace.print(new String("").isEmpty());
    Trace.print(s.isEmpty());
    Trace.print("".isEmpty());

    // equalsIgnoreCase
    Trace.print(boxed.equalsIgnoreCase("hello"));
    Trace.print(sw.equalsIgnoreCase("HELLO WORLD"));
}
