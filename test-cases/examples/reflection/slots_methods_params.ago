class Staff{
    public name as string;
    age as int {public get; public set;}

    fun work(title as string, duration as int){
        Trace.print($"name: ${name} do ${title}, already ${duration} min"$)
    }
}

fun main(){
    var slots = Staff.class.getSlots();
    for(var slot in slots){
        Trace.print(slot.toString());
        Trace.print(slot.index);
    }

    var methods = Staff.class.methods;
    Trace.print(methods.length);

    var workMethod = Staff.class.getMethod('work#', false);
    var params = workMethod!.getParameters();
    for(var param in params){
        Trace.print(param.toString());
        Trace.print(param.index);
        Trace.print(param.slotIndex);
    }
}
