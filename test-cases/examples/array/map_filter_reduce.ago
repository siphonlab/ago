fun dbl(x as int) as int {
    return x * 2;
}

fun isEven(x as int) as boolean {
    return x % 2 == 0;
}

fun sum(acc as int, x as int) as int {
    return acc + x;
}

fun product(acc as int, x as int) as int {
    return acc * x;
}

fun toStr(x as int) as string {
    return "n" + x;
}

fun main(){
    var nums = [1, 2, 3, 4, 5, 6];

    // map: double each element
    var doubled = nums.map<>(dbl);
    for(var v in doubled){
        Trace.print(v);
    }

    // filter: keep only even numbers
    var evens = nums.filter(isEven);
    for(var v in evens){
        Trace.print(v);
    }

    // reduce: sum all elements
    var s = nums.reduce<int, int>(sum, 0);
    Trace.print(s);

    // reduce: product of even numbers (filter + reduce chain)
    var p = nums.filter(isEven).reduce<int, int>(product, 1);
    Trace.print(p);

    // map to string and join
    var strs = nums.map<>(toStr);
    Trace.print(strs.join("-"));
}
