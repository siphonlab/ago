fun main(){
//    var arr = [1, 2, 3];
    var arr = [1|Object, 2, 3];

    if(arr instanceof Array<_> a){
        Trace.print("it's an array, length is " + a.length)

        if(a instanceof Array<int> ints){
            for(var el in ints){
                Trace.print(el)
            }
        } else if(a instanceof Array<Object> objs){
            for(var i=0; i< objs.length; i++){
                Trace.print(objs[i])
            }
        }
    }
}