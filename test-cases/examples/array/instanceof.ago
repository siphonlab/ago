fun main(){
//    var arr = [1, 2, 3];
    var arr = [1|Integer, 2, 3];

    if(arr instanceof Array<_> a){
        Trace.print("it's an array, length is " + a.length)

        if(a instanceof Array<int> ints){
            for(var el in ints){
                Trace.print(el)
            }
        } else if(a.isObjectArray()){
            for(var i=0; i< a.length; i++){
                Trace.print(a.getObjectElement(i))
            }
        }
    }
}